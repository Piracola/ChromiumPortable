{
  "targets": {
    "chrome_stable": {
      "name": "Chrome",
      "display_name": "Chrome++",
      "product": true,
      "output_dir": "Chrome",
      "exe_name": "chrome.exe",
      "architecture": "x64",
      "provider": {
        "type": "google_omaha",
        "channel": "win_stable_x64"
      },
      "version_root": "Chrome-bin",
      "layout": "move_version_root",
      "ini_location": "app_root",
      "version_dll_location": "app_root",
      "start_script": "开始.bat",
      "archive_name": "Chrome++_stable_{version}_{date}.7z",
      "release": {
        "tag": "v{version}",
        "title": "Chrome++ {version}",
        "asset_match": "stable",
        "body": "Chrome++ 构建版本\n\n构建时间: {date}\nChrome 版本: {version}\n"
      }
    },
    "chrome_beta": {
      "name": "Chrome",
      "display_name": "Chrome++ Beta",
      "product": true,
      "output_dir": "Chrome",
      "exe_name": "chrome.exe",
      "architecture": "x64",
      "provider": {
        "type": "google_omaha",
        "channel": "win_beta_x64"
      },
      "version_root": "Chrome-bin",
      "layout": "move_version_root",
      "ini_location": "app_root",
      "version_dll_location": "app_root",
      "archive_name": "Chrome++_beta_{version}_{date}.7z",
      "release": {
        "tag": "v{version}",
        "title": "Chrome++ Beta {version}",
        "asset_match": "beta",
        "body": "Chrome++ Beta 构建版本\n\n构建时间: {date}\nChrome Beta 版本: {version}\n"
      }
    },
    "edge_stable": {
      "name": "Edge",
      "display_name": "Microsoft Edge",
      "product": true,
      "output_dir": "Edge",
      "exe_name": "msedge.exe",
      "architecture": "x64",
      "provider": {
        "type": "microsoft_edge",
        "app_id": "msedge-stable-win-x64",
        "verify_ssl": false
      },
      "version_root": "Chrome-bin",
      "inner_archive": "MSEDGE.7Z",
      "layout": "move_version_dir",
      "ini_location": "version_dir",
      "version_dll_location": "version_dir",
      "start_script": "开始.bat",
      "archive_name": "Edge_Portable_Win64_{version}_{date}.7z",
      "release": {
        "tag": "v{version}",
        "title": "Edge {version}",
        "asset_match": "Edge_Portable",
        "body": "自动构建的 Microsoft Edge 便携版，集成 Chrome++ 便携化增强组件。\n\n## 版本\n- Edge 版本: {version}\n"
      }
    },
    "helium_stable": {
      "name": "Helium",
      "display_name": "Helium",
      "product": true,
      "output_dir": "Helium",
      "architecture": "x64",
      "provider": {
        "type": "script",
        "command": ["python", "scripts/upstream/resolve.py", "--browser", "helium"]
      },
      "layout": "auto",
      "ini_location": "app_root",
      "version_dll_location": "app_root",
      "start_script": "开始.bat",
      "archive_name": "Helium_{version}_{date}.7z",
      "release": {
        "tag": "v{version}",
        "title": "Helium {version}",
        "asset_match": "Helium_",
        "body": "自动构建的 Helium 便携版。\n\n## 版本\n- Helium 版本: {version}\n"
      }
    },
