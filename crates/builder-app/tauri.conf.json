{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChromiumPortableBuilder",
  "version": "2.0.0",
  "identifier": "org.piracola.chromiumportable.builder",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ChromiumPortable 便携构建器",
        "width": 980,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
