{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChromiumPortableBuilder",
  "version": "2.0.0",
  "identifier": "org.piracola.chromiumportable.builder",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ChromiumPortable 便携构建器",
        "width": 1024,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
